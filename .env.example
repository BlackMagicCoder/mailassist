# Kopie als .env anlegen (chmod 600). .env wird von git ignoriert.

# Pflicht: NanoGPT-API-Schlüssel (https://nano-gpt.com)
NANOGPT_API_KEY=

# Modell (Standard: anthropic/claude-sonnet-latest – ein Alias, den NanoGPT auf neuere Sonnet-Versionen umstellen kann)
#MAILASSIST_MODEL=anthropic/claude-sonnet-latest

# Telegram-Bot (nur für "mailassist bot")
TELEGRAM_BOT_TOKEN=
# Kommagetrennte Telegram-Nutzer-IDs, die den Bot benutzen dürfen. Leer = Bot startet nicht.
TELEGRAM_ALLOWED_USER_IDS=

# Eigene Adressen, damit eigene Nachrichten im Verlauf als "owner" markiert werden
#MAILASSIST_OWN_ADDRESSES=ich@proton.me
# Signatur unter jedem Entwurf (\n für Zeilenumbruch); ohne Angabe setzt das Modell [[TODO: Name]]
#MAILASSIST_SIGNATURE=Viele Grüße\nKira

# Selten nötig
#BARYON_COMMAND=baryon-mcp
#MAILASSIST_INBOX_FOLDER=INBOX
#MAILASSIST_SEARCH_FOLDER=All Mail
#MAILASSIST_MAX_TOKENS=2000
#MAILASSIST_DATA_DIR=data

# Wissensbasis: Ordner mit freigegebenen Unternehmensinformationen (siehe README)
#MAILASSIST_KNOWLEDGE_DIR=knowledge
# Geprüfte Baryon-Version; leer = keine Prüfung (nicht empfohlen)
#MAILASSIST_BARYON_VERSION=0.6.3
