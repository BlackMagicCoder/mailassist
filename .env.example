# Kopie als .env anlegen (chmod 600). .env wird von git ignoriert.

# Pflicht: Amazon-Bedrock-API-Schlüssel (AWS-Konsole → Amazon Bedrock → API keys).
# Statt BEDROCK_API_KEY wird auch AWS_BEARER_TOKEN_BEDROCK gelesen.
BEDROCK_API_KEY=

# Region und Modell (Standard: OpenAI gpt-oss-120b in Frankfurt, die Anfragen bleiben in eu-central-1).
# Jede Bedrock-Modell-ID, die dein Konto aufrufen darf, funktioniert (Converse-API);
# Inferenzprofile mit Präfix (eu.…, us.…) nur mit passender Region.
#BEDROCK_REGION=eu-central-1
#MAILASSIST_MODEL=openai.gpt-oss-120b-1:0

# Telegram-Bot (nur für "mailassist bot")
TELEGRAM_BOT_TOKEN=
# Kommagetrennte Telegram-Nutzer-IDs, die den Bot benutzen dürfen. Leer = Bot startet nicht.
TELEGRAM_ALLOWED_USER_IDS=

# Eigene Adressen, damit eigene Nachrichten im Verlauf als "owner" markiert werden
#MAILASSIST_OWN_ADDRESSES=ich@proton.me
# Signatur unter jedem Entwurf (\n für Zeilenumbruch); ohne Angabe setzt das Modell [[TODO: Name]]
#MAILASSIST_SIGNATURE=Viele Grüße\nKira

# Selten nötig
#BARYON_COMMAND=baryon-mcp
#MAILASSIST_INBOX_FOLDER=INBOX
#MAILASSIST_SEARCH_FOLDER=All Mail
#MAILASSIST_MAX_TOKENS=4000
#MAILASSIST_DATA_DIR=data

# Wissensbasis: Ordner mit freigegebenen Unternehmensinformationen (siehe README)
#MAILASSIST_KNOWLEDGE_DIR=knowledge
# Geprüfte Baryon-Version; leer = keine Prüfung (nicht empfohlen)
#MAILASSIST_BARYON_VERSION=0.6.3

# Postfach-Anbindung: baryon (Proton über Bridge, Standard) oder imap (T-Online, GMX, web.de, …)
#MAILASSIST_CONNECTOR=imap
#IMAP_USER=deine-adresse@t-online.de
# Bei T-Online: das "Passwort für E-Mail-Programme", NICHT das Telekom-Login-Passwort
#IMAP_PASSWORD=
#IMAP_HOST=secureimap.t-online.de
#IMAP_PORT=993
# Nur falls `mailassist check` die Ordner nicht findet:
#IMAP_DRAFTS_FOLDER=Entwürfe
#IMAP_SENT_FOLDER=Gesendet
